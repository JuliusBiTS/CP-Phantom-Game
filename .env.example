# Copy to .env.local for local dev. On Vercel, set these as Project → Settings →
# Environment Variables. NEVER commit real values — .env* is gitignored.

# ── Anthropic (the one paid dependency) ──────────────────────────────────────
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Narrator model. Defaults to claude-sonnet-5 (cheaper per turn). Set to
# claude-opus-5 for maximum narration quality at ~2.5x input / 2.5x output cost.
SOLO_MODEL=claude-sonnet-5

# Background jobs (fact compression, recaps, the rumor mill) run on a cheaper
# model by default. Override if you want; leave unset for claude-haiku-4-5.
# SOLO_COMPRESS_MODEL=claude-haiku-4-5-20251001
# SOLO_RECAP_MODEL=claude-haiku-4-5-20251001
# SOLO_WORLDTICK_MODEL=claude-haiku-4-5-20251001

# ── Voice dictation (all optional) ──────────────────────────────────────────
# Dictation works with NO key: Chrome/Edge use the built-in Web Speech API,
# other browsers download a local Whisper model. For best accuracy set ONE of
# these and the Dictate button uses it instead (server-side, key never exposed):
#   GROQ_API_KEY  — Groq whisper-large-v3-turbo. Free tier; fast + accurate.
#   OPENAI_API_KEY — OpenAI whisper-1 ($0.006/min).
GROQ_API_KEY=
# OPENAI_API_KEY=

# ── Firebase Realtime Database (optional) ────────────────────────────────────
# If unset, the app persists campaigns to browser localStorage instead — fine
# for a single-machine playtest, not for cross-device / cross-session.
# These are the PUBLIC web-app config values (safe to expose); access is
# governed by database security rules, not by hiding these.
# Reuse the SAME Firebase project as CP Phantom — the solo tool only ever
# touches the `soloCampaigns/` top-level node (enforced in code + rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
